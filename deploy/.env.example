# ===== 宿主机路径（docker-compose 卷挂载源） =====
# Lance 数据集所在目录（挂载到容器 /data）
HOST_DATA_PATH=/home/czk/projects/lance_viz_new
# NAS 挂载路径
HOST_NAS_PATH=/mnt/nas-222-project
# assets 目录（相对于 deploy/ 的相对路径，或绝对路径）
HOST_ASSETS_PATH=../assets
# annotations 持久化目录
HOST_ANNOTATIONS_PATH=../annotations

# ===== 应用配置 =====
APP_PORT=8868
TZ=Asia/Shanghai

# ===== 容器内路径（传给 Python 代码） =====
# Lance 数据集完整路径
LANCE_DATASET=/mnt/nas-222-project/mocap/releases/v0.5/trajectories_preprocessed.lance
# MANO 模型文件路径
MANO_MODEL_PATH=/app/assets/models/MANO_RIGHT.pkl
# 标注数据存储目录
ANNOTATIONS_DIR=/app/annotations
