# ============================================
# 必填：Lance 数据集路径
# ============================================
# .lance 数据集所在目录（例如 /mnt/nas-222-project/mocap_v2/lance_datasets）
# 注意：填 .lance 的【上级目录】，不要填 .lance 本身；该目录挂载到容器 /data，
# 具体加载哪个数据集在前端"浏览"中选择，可随时切换
HOST_DATA_PATH=/path/to/lance_datasets

# ============================================
# 可选：以下均有合理默认值，一般无需修改
# ============================================

# 基础镜像源（默认 python:3.10，即 Docker Hub）
# 公司内网建议改用 Harbor 缓存，拉取更快更稳：
# BASE_IMAGE=183.195.186.154:180/dockerhub/library/python:3.10
# Docker Hub 不可达时可换公共加速器：
# BASE_IMAGE=docker.1ms.run/library/python:3.10

# NAS 挂载路径（默认与 HOST_DATA_PATH 相同）
# 仅团队内部需要保留 /mnt/nas-222-project 原始路径时设置：
# HOST_NAS_PATH=/mnt/nas-222-project

# assets 资源目录（默认使用仓库内的 assets）
# HOST_ASSETS_PATH=../assets

# 服务端口（默认 8868）
# APP_PORT=8868

# 时区（默认 Asia/Shanghai）
# TZ=Asia/Shanghai

# 前端数据源浏览根目录，多个路径用 : 分隔（默认自动扫描 /data 与 /mnt/nas*）
# DATA_BROWSER_ROOTS=/data:/mnt/nas-222-project

# PostgreSQL（仅用于"最近数据源列表"功能，不需要则保持注释）
# DATABASE_URL=postgresql://admin:password@192.168.8.100:15432/dex_database
