# ===== 宿主机路径（docker-compose 卷挂载源）=====
# Lance 数据集所在目录（挂载到容器 /data）
HOST_DATA_PATH=/home/czk/projects/lance_viz_new
# NAS 挂载路径
HOST_NAS_PATH=/mnt/nas-222-project
# 可选：基础镜像源（默认内网 Harbor 缓存；公网环境改为 python:3.10 或公共加速器）
# BASE_IMAGE=python:3.10

# 可选：前端数据源浏览根目录，多个路径用 : 分隔；不填则自动扫描 /data 与 /mnt/nas*
# DATA_BROWSER_ROOTS=/data:/mnt/nas-222-project
# assets 目录（相对于 deploy/ 的相对路径，或绝对路径）
HOST_ASSETS_PATH=../assets

# ===== Docker 服务配置 =====
APP_PORT=8868
TZ=Asia/Shanghai

# ===== PostgreSQL（读取 public.lance_record 数据源列表）=====
# 二选一：
# 1. 直接提供完整 DATABASE_URL
# DATABASE_URL=postgresql://admin:password@192.168.8.100:15432/dex_database
#
# 2. 或拆分配置
# DB_HOST=192.168.8.100
# DB_PORT=15432
# DB_NAME=dex_database
# DB_USER=admin
# DB_PASSWORD=change_me

# 默认情况下无需额外挂载 viz_config.yaml；可通过环境变量覆盖关键路径
